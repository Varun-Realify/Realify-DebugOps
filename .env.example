# ---- Database (used by postgres, api, worker) ----
POSTGRES_USER=debugops
# Use URL-safe characters only (e.g. `openssl rand -hex 24`).
POSTGRES_PASSWORD=change-me
POSTGRES_DB=debugops

# ---- Application ----
# Required. 32+ chars. Generate: openssl rand -hex 32
SECRET_KEY=
# Keep true in production (HTTPS). Set false ONLY for plain-http local testing.
COOKIE_SECURE=true
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
LOG_LEVEL=INFO

# ---- Web ----
# Host interface/port for the dashboard. Put a TLS-terminating reverse proxy in front for production.
WEB_BIND=127.0.0.1
WEB_PORT=8088

# ---- GitHub App (see docs/GITHUB_APP.md). Leave blank to run without GitHub. ----
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Put the downloaded .pem in ./secrets/ (chmod 600). It is mounted read-only into api/worker.
GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github-app.pem
# Alternative for platforms without file mounts (escape newlines as \n). Prefer the file.
GITHUB_APP_PRIVATE_KEY=
# Generate: openssl rand -hex 32. Paste the same value into the GitHub App's webhook secret.
GITHUB_WEBHOOK_SECRET=
# GitHub Enterprise Server: https://HOST/api/v3 and https://HOST
GITHUB_API_URL=https://api.github.com
GITHUB_WEB_URL=https://github.com

# ---- Sandbox (scans run in throwaway containers). Defaults are sensible; tune for your host. ----
# SANDBOX_MEMORY=2g
# SANDBOX_CPUS=2
# SANDBOX_PIDS=512
# SANDBOX_SCAN_TIMEOUT_SECONDS=2700
# MAX_REPO_BYTES=300000000
# Allowed egress domains for sandboxes: edit egress-proxy/allowlist.txt and `docker compose up -d --build egress-proxy`.

# ---- AI agents (Claude). Leave blank to run detection only; investigations then return 503. ----
# Use a dedicated, spend-limited Anthropic workspace key for DebugOps.
ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-opus-5-5
# AGENT_EFFORT=high
# Per-run budgets enforced by the llm-gateway (requests and input+output tokens):
# RUN_MAX_LLM_REQUESTS=600
# RUN_MAX_LLM_TOKENS=8000000
# MAX_FIX_ATTEMPTS=3
# ROOT_CAUSE_MIN_CONFIDENCE=0.6

# ---- Monitoring ----
# LOG_FORMAT=json            # json lines to stdout (default) for centralized logging; "text" for humans
# SENTRY_DSN=                # optional error tracking (Sentry or GlitchTip); no request bodies/cookies are sent
# ENVIRONMENT_NAME=production

# ---- AWS DevOps Agent (production incident investigations over MCP) ----
# Bearer token for one Agent Space: an admin first enables access tokens (console > Configuration), then the token is
# created in the DevOps Agent web app (Settings > Access Tokens) with the read + operate scopes, client type agent,
# expiry 1-60 days. Rotate before it expires. Production: prefer SigV4 (docs/AWS_DEVOPS_AGENT.md).
# Only the worker and llm-gateway receive it; sandboxes never do. Verify: docker compose exec api python -m app.cli devops-agent-check
DEVOPS_AGENT_TOKEN=
DEVOPS_AGENT_REGION=ap-south-1
# DEVOPS_AGENT_URL=          # default https://connect.aidevops.<region>.api.aws/mcp
# DEVOPS_AGENT_TIMEOUT_SECONDS=120
# CloudWatch alarms -> SNS -> DebugOps (automatic workflow). Only these SNS topics are accepted; empty disables /api/v1/aws/sns.
# SNS_TOPIC_ARNS=["arn:aws:sns:ap-south-1:123456789012:realify-prod-alarms"]
